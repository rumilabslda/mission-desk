{
  "name": "mission-desk",
  "productName": "Mission Desk",
  "version": "0.2.0",
  "description": "Free, open-source desktop app: all your web apps (Google, Microsoft 365, Slack, WhatsApp and more) side by side, organised in spaces, with one Home for your day and an assistant per space.",
  "author": "Rumi Labs, Lda.",
  "license": "GPL-3.0-or-later",
  "private": true,
  "main": "out/main/index.js",
  "desktopName": "mission-desk.desktop",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --mac dir -c.mac.identity=null",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "release": "electron-vite build && electron-builder --publish always"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "happy-dom": "^20.14.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "electron-updater": "6.8.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tldts": "^7.5.4",
    "zod": "^4.6.7"
  },
  "homepage": "https://rumilabs.pt"
}
