<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's JavaScript engine needs these under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Calls in Meet, Teams, Slack and WhatsApp. -->
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Passkeys (src/main/passkeys): Mission Desk keeps them in this keychain group, unlocked with
       Touch ID. These three are allowed only by the provisioning profile embedded in the app
       (build/Mission_Desk_Developer_ID.provisionprofile, docs/RELEASING.md); a signed build without it won't open. -->
  <key>com.apple.application-identifier</key>
  <string>WY943M5DF7.pt.rumilabs.missiondesk</string>
  <key>com.apple.developer.team-identifier</key>
  <string>WY943M5DF7</string>
  <key>keychain-access-groups</key>
  <array>
    <string>WY943M5DF7.pt.rumilabs.missiondesk.webauthn</string>
  </array>
</dict>
</plist>
